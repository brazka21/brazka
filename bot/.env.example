# Скопируйте этот файл в .env и заполните значения.
# Никогда не публикуйте настоящий токен в GitHub.

BRAZKA_BOT_TOKEN=1234567890:PASTE_REAL_TOKEN_HERE

# Сначала можно оставить пустым, запустить бота и отправить ему /id.
# Затем вставьте полученный chat ID и перезапустите бота.
BRAZKA_ADMIN_CHAT_ID=

BRAZKA_WEBAPP_URL=https://brazka.shop/app/

# Если Telegram без VPN не открывается, раскомментируйте прокси HAPP:
# HTTPS_PROXY=http://127.0.0.1:10809
# HTTP_PROXY=http://127.0.0.1:10809
